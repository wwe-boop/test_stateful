# Copy to repo root as `.env.data_synth` and fill in credentials.
#   cp eval/data_synth/env.example .env.data_synth
#
# Then load with:
#   source scripts/bash/setup_data_synth_env.sh

# Default provider: dashscope | ark
DATA_SYNTH_PROVIDER=dashscope

# DashScope compatible-mode (OpenAI SDK)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DATA_SYNTH_MODEL=qwen-plus

# Volcengine Ark (OpenAI-compatible endpoint)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Required when DATA_SYNTH_PROVIDER=ark, e.g. ep-2024xxxxxx-xxxxx
ARK_MODEL=
